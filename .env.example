# =============================================================================
# Variabili d'ambiente — copiare in .env.local e compilare i valori reali.
# Le `NEXT_PUBLIC_*` sono esposte al browser; tutte le altre sono server-only.
# =============================================================================

# -- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Necessaria per:
#  - /api/account/delete (cancellazione hard dell'account dell'utente)
#  - /api/admin/users/[id]/delete (cancellazione utenti da admin)
#  - webhook Stripe (creazione/aggiornamento ordini)
#  - reconciliation cash on delivery
# Supabase Dashboard → Settings → API → service_role key.
# NON commitarla. NON esporla nel client (mai NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL pubblico dell'app (usato in link email, redirect Stripe Checkout, e nel
# `canonical`/`og:url` di ogni pagina).
#
# ⚠️ IN PRODUZIONE VA MESSA, SEMPRE. Il 22/8/2026 mancava fra le variabili su
# Vercel, e il sito serviva a Google `<link rel="canonical" href="http://
# localhost:3000">` su ogni pagina, con le anteprime dei link condivisi tutte
# rotte. Nessun errore nei log: rispondeva 200 e sembrava a posto.
# Adesso, se manca, il codice ripiega sul dominio che Vercel dichiara da solo
# (lib/env.ts) invece che su localhost — ma quello e' il paracadute, non la
# scala: /api/health continua a dire «non sto in piedi» finche' non la metti.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -- Anthropic (AI vision) ---------------------------------------------------
# Usato da /api/vision/extract-product per la compilazione automatica dei
# campi prodotto via foto. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# -- Stripe (pagamenti) ------------------------------------------------------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret per /api/stripe/webhook (Dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Connect (onboarding seller) — opzionale in dev
STRIPE_CONNECT_CLIENT_ID=ca_...

# -- Resend (email transazionale) --------------------------------------------
# https://resend.com/api-keys — dominio verificato con DKIM/SPF/DMARC.
RESEND_API_KEY=re_...
RESEND_FROM="MyCity <no-reply@mycity.it>"
RESEND_REPLY_TO=support@mycity.it

# -- Cloudflare Turnstile (CAPTCHA) ------------------------------------------
# https://dash.cloudflare.com → Turnstile → site
# Senza queste chiavi il CAPTCHA è disabilitato (solo per dev locale).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# -- KYC provider (verifica documento + face match) --------------------------
# Provider supportati: onfido | jumio | veriff | mock (default mock).
KYC_PROVIDER=mock
KYC_API_KEY=

# -- Rimozione sfondo (foto prodotto su sfondo bianco) -----------------------
# Usato da /api/image/remove-bg per scontornare il prodotto e metterlo su
# sfondo bianco uniforme. Provider: removebg | photoroom | mock (default mock
# per dev/CI). In produzione, se il provider reale non e' configurato,
# l'endpoint risponde 503 (mai cutout finti in prod).
# remove.bg: https://www.remove.bg/api  —  Photoroom: https://www.photoroom.com/api
BG_REMOVAL_PROVIDER=mock
REMOVE_BG_API_KEY=
PHOTOROOM_API_KEY=

# -- Sentry (error tracking) — opzionale -------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
# Server-side only — usato da withSentryConfig per upload source maps in build
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# -- PostHog (analytics + session replay) — opzionale ------------------------
# https://eu.posthog.com → Project → Project Settings → API Keys
NEXT_PUBLIC_POSTHOG_KEY=
# #227 — Deve essere l'indirizzo che RICEVE gli eventi, e lo stesso che sta
# fra le variabili del progetto su Vercel. Qui c'era https://eu.posthog.com:
# e' il sito del pannello, non
# l'ingresso degli eventi (che finisce per .i.posthog.com), ed era per giunta
# un continente diverso da quello di produzione. Chi copiava questo file per
# lavorare in locale mandava gli eventi in un posto che non li raccoglie.
# Il trasferimento verso gli Stati Uniti resta una decisione aperta (#220).
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -- Google Analytics 4 — opzionale ------------------------------------------
# Se vuoto, GA non viene caricato. Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# -- Push notifications (VAPID) — opzionale ----------------------------------
# Genera con: npx web-push generate-vapid-keys
# Solo la public va esposta. Quella private resta server-side per firmare.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mycity.it

# -- Cron secret (protezione endpoint /api/cron/*) ---------------------------
# Genera con: openssl rand -hex 32
# I lavori periodici li fa partire Vercel: l'elenco e le cadenze stanno in
# `vercel.json` → `crons`. Vercel manda da solo questo segreto come
#   Authorization: Bearer $CRON_SECRET
# a patto che la variabile si chiami ESATTAMENTE CRON_SECRET fra le variabili
# del progetto. Se manca, i lavori partono e si prendono un 401: silenziosi,
# perche' il giro «e' andato», ma senza fare niente.
CRON_SECRET=

# -- Internal API secret (endpoint server-to-server: /api/stripe/payout) ------
# Secret DEDICATO per gli endpoint protetti da withInternalAuth (header
# x-internal-secret). Rotabile indipendentemente dalla service-role key. Se
# vuoto, si usa SUPABASE_SERVICE_ROLE_KEY come fallback (retrocompatibilità).
# Genera con: openssl rand -hex 32
INTERNAL_API_SECRET=

# -- Contact form ------------------------------------------------------------
# Email che riceve i messaggi inviati da /contact
SUPPORT_EMAIL=support@mycity.it

# -- WhatsApp Business (link contatti) — opzionale ---------------------------
# Numero internazionale senza + (es. 393331234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# -- Upstash Redis (freno anti-abuso) — SERVE in produzione su Vercel --------
# Era «opzionale» quando il sito girava su Render: una macchina accesa, un solo
# contatore in memoria, e il freno valeva quanto dice il numero nel codice. Su
# Vercel ogni richiesta puo' finire su una copia diversa, e ogni copia parte coi
# contatori a zero: «dieci tentativi di accesso al minuto» diventa dieci per
# ogni copia. Il ripiego in memoria resta (mai lasciare il sito senza freno), ma
# e' molto piu' largo di quanto sembri.
# Senza queste due, /api/health risponde «degradato»: cosi' la cosa si vede.
# https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -- Firma dei link di disiscrizione dalle email — OBBLIGATORIA in produzione -
# 081 — Senza, la firma ripiegava sulla chiave di servizio di Supabase o su una
# stringa scritta nel codice: chiunque la conoscesse poteva disiscrivere
# chiunque. Su Vercel generane una lunga e casuale, mai riusata altrove.
# (Viveva solo in render.yaml, che e' stato tolto quando il sito e' passato a
# Vercel: qui non si perde.)
UNSUBSCRIBE_SECRET=

# -- Firma del cookie del ruolo (mc_ruolo) -----------------------------------
# 22/8/2026 — È la chiave che firma il cookie con ruolo e stato di approvazione,
# quello che evita di rileggere il profilo dal database a ogni pagina.
#
# Prima non era dichiarata da nessuna parte, e il codice ripiegava su
# UNSUBSCRIBE_SECRET — cioè sulla chiave che finisce nel link in fondo a ogni
# email spedita. Una chiave che esce in ogni email non è più un segreto, e chi
# la conosce può falsificare un cookie di ruolo. Il ripiego è stato tolto.
#
# Se manca, il sito funziona lo stesso: rilegge il profilo dal database ogni
# volta. Si perde la comodità, non la sicurezza.
# Genera con:  openssl rand -hex 32
MIDDLEWARE_CACHE_SECRET=


# -- Tetto di spesa giornaliero per le chiamate all'AI, in euro ---------------
# Il tetto leggeva una variabile che nessuno aveva mai messo, quindi valeva
# zero — e zero vuol dire «nessun limite». Un ciclo impazzito poteva spendere
# senza freno, e il primo segnale sarebbe stata la fattura. Venti euro al
# giorno sono larghi per l'uso vero e stretti per un guasto.
AI_GLOBAL_DAILY_BUDGET_EUR=20

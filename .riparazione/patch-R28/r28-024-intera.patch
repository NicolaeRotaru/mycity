diff --git a/tests/unit/riparazione-r28-confine-non-misurato.test.ts b/tests/unit/riparazione-r28-confine-non-misurato.test.ts
new file mode 100644
index 00000000..ec2cf8e0
--- /dev/null
+++ b/tests/unit/riparazione-r28-confine-non-misurato.test.ts
@@ -0,0 +1,185 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+
+/**
+ * R28-024 — UN CONFINE SENZA COORDINATE ERA CHIUSO SOLO A PAROLE.
+ *
+ * Se il negozio non ha la posizione sulla vetrina, o l'indirizzo del cliente non si trova sulla
+ * mappa, la cassa in contanti non può misurare i 5 km e l'ordine passa (`fuoriZonaDiConsegna` dice
+ * «no» quando non sa). /shipping lo dice e il pannello consegne dice «la distanza va guardata a
+ * mano», ma l'ordine nasceva senza nessun segno: nessuno sapeva quale guardare. Adesso, a ordine
+ * nato, gli amministratori ricevono la campanella (la stessa di «serve un controllo a mano»).
+ *
+ * Il banco è quello di i-contanti-misurano-il-confine-in-ogni-direzione-e-da-ogni-fonte: rotta vera,
+ * autenticazione e database finti; qui si raccolgono i lavori «dopo la risposta» e gli avvisi.
+ */
+
+type Coord = { lat: number; lng: number };
+type Fonte = 'rubrica' | 'geocodifica';
+
+const NEGOZIO_ID = 'aaaaaaaa-0000-0000-0000-000000000001';
+const PRODOTTO = '11111111-1111-1111-1111-111111111111';
+const NEGOZIO = { lat: 45.0526, lng: 9.6929, nome: 'Pane Quotidiano' };
+
+const fonti: Record<Fonte, Coord | null> = { rubrica: null, geocodifica: null };
+const ordiniCreati: Array<Record<string, unknown>> = [];
+const dopo: Array<() => Promise<void>> = [];
+const avvisi: Array<{ titolo: string; corpo: string; link: string }> = [];
+/** La posizione del negozio sulla vetrina: `null` = il negozio non l'ha ancora messa. */
+const vetrina: { posizione: Coord | null } = { posizione: { lat: 0, lng: 0 } };
+const chiamateRpc: string[] = [];
+/** Il carrello con più negozi: acceso, il database finto risponde con questi al posto del negozio solo. */
+const carrello: { venditori: unknown[] | null; prodotti: unknown[] | null } = { venditori: null, prodotti: null };
+
+vi.mock('@/lib/logger', () => ({ logger: { error: vi.fn(), warn: vi.fn(), info: vi.fn(), spesa: vi.fn() } }));
+vi.mock('@/lib/api/middleware', () => ({
+  withAuthRateLimit:
+    (
+      _o: unknown,
+      h: (ctx: { user: { id: string; email: string; email_confirmed_at: string }; profile: unknown; req: unknown }) => unknown,
+    ) =>
+    (req: unknown) =>
+      h({
+        user: { id: 'cliente-1', email: 'cliente@test.it', email_confirmed_at: '2026-01-01T00:00:00Z' },
+        profile: { role: 'buyer', is_approved: true },
+        req,
+      }),
+  assertCanPurchase: vi.fn(() => null),
+}));
+vi.mock('@/lib/store-hours', () => ({
+  negozioPuoServire: vi.fn(() => true),
+  motivoNegozioChiuso: vi.fn((n: string) => `${n} è chiuso.`),
+}));
+vi.mock('@/lib/promotions', () => ({
+  fetchActiveDiscounts: vi.fn(async () => new Map()),
+  discountedUnitCents: vi.fn((prezzo: number) => Math.round(prezzo * 100)),
+}));
+vi.mock('@/lib/coupons', () => ({ validateCoupon: vi.fn(async () => ({ ok: false, reason: 'nessun codice' })) }));
+vi.mock('@/lib/email/client', () => ({ sendEmail: vi.fn(async () => ({ ok: true })) }));
+vi.mock('@/lib/api/dopo-la-risposta', () => ({ dopoLaRisposta: (lavoro: () => Promise<void>) => { dopo.push(lavoro); } }));
+vi.mock('@/lib/stripe/webhook/comune', async (originale) => ({
+  ...((await originale()) as Record<string, unknown>),
+  notifyAdmins: vi.fn(async (titolo: string, corpo: string, link: string) => { avvisi.push({ titolo, corpo, link }); return 'scritto'; }),
+}));
+// Le due strade da cui la rotta prende la posizione della casa. Ogni caso ne accende una sola.
+vi.mock('@/lib/shipping-coordinate', () => ({ coordinateDaIndirizziSalvati: vi.fn(async () => fonti.rubrica) }));
+vi.mock('@/lib/geocodifica', () => ({ coordinateDiUnIndirizzo: vi.fn(async () => fonti.geocodifica) }));
+
+vi.mock('@/lib/supabase/server', () => {
+  const prodotti = [
+    { id: PRODOTTO, seller_id: NEGOZIO_ID, name: 'Pane', price: 12, stock: 10, has_variants: false, images: [], status: 'available' },
+  ];
+  const venditori = () => [
+    { id: NEGOZIO_ID, store_name: NEGOZIO.nome, store_lat: vetrina.posizione?.lat ?? null, store_lng: vetrina.posizione?.lng ?? null, store_hours: null },
+  ];
+  /** Una catena di query che accetta ogni passo e alla fine risponde `lista` (o `singolo`, per una riga). */
+  const catena = (lista: unknown, singolo: unknown = { data: null, error: null }) => {
+    const b: Record<string, unknown> = {};
+    for (const passo of ['select', 'eq', 'neq', 'in', 'is', 'gt', 'gte', 'lt', 'lte', 'filter', 'order', 'limit', 'not', 'or', 'update', 'upsert', 'delete', 'insert']) {
+      b[passo] = () => b;
+    }
+    b.single = () => Promise.resolve(singolo);
+    b.maybeSingle = () => Promise.resolve(singolo);
+    b.then = (ok: (v: unknown) => unknown, ko?: (e: unknown) => unknown) => Promise.resolve(lista).then(ok, ko);
+    return b;
+  };
+  const from = (tavola: string): Record<string, unknown> => {
+    if (tavola === 'products') return catena({ data: carrello.prodotti ?? prodotti, error: null });
+    if (tavola === 'seller_public_profiles') return catena({ data: carrello.venditori ?? venditori(), error: null });
+    if (tavola === 'orders') {
+      const c = catena({ data: [], error: null });
+      c.insert = (riga: unknown) => {
+        ordiniCreati.push((Array.isArray(riga) ? riga[0] : riga) as Record<string, unknown>);
+        return catena({ data: [{ id: 'ord-1' }], error: null }, { data: { id: 'ord-1' }, error: null });
+      };
+      return c;
+    }
+    return catena({ data: [], error: null });
+  };
+  return {
+    getAdminSupabase: () => ({
+      from,
+      rpc: (nome: string) => {
+        chiamateRpc.push(nome);
+        return Promise.resolve({ data: null, error: null });
+      },
+      auth: { admin: { getUserById: async () => ({ data: { user: { email: 'negozio@test.it' } } }) } },
+    }),
+    getServerSupabase: async () => ({ from }),
+  };
+});
+
+/** L'ordine in contanti. Il browser dice di stare davanti al negozio: la rotta non deve fidarsi. */
+function ordina(groups: unknown[] = [{ sellerId: NEGOZIO_ID, items: [{ productId: PRODOTTO, quantity: 1 }] }]): never {
+  return new Request('http://localhost/api/orders/cod', {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({
+      groups,
+      delivery: {
+        fullName: 'Maria Rossi',
+        address: 'Via Emilia 1',
+        city: 'Piacenza',
+        zip: '29121',
+        phone: '3331234567',
+        lat: NEGOZIO.lat,
+        lng: NEGOZIO.lng,
+      },
+      pickupInStore: false,
+      useCredit: false,
+    }),
+  }) as never;
+}
+
+async function paga(casa: Coord | null, fonte: Fonte, groups?: unknown[]) {
+  fonti.rubrica = fonte === 'rubrica' ? casa : null;
+  fonti.geocodifica = fonte === 'geocodifica' ? casa : null;
+  const { POST } = await import('@/app/api/orders/cod/route');
+  const res = await (POST as unknown as (req: never) => Promise<Response>)(ordina(groups));
+  const corpo = (await res.json()) as { error?: { message?: string } };
+  for (const lavoro of dopo.splice(0)) await lavoro();
+  return { res, corpo };
+}
+
+beforeEach(() => {
+  ordiniCreati.length = 0;
+  chiamateRpc.length = 0;
+  dopo.length = 0;
+  avvisi.length = 0;
+  fonti.rubrica = null;
+  fonti.geocodifica = null;
+  carrello.venditori = null;
+  carrello.prodotti = null;
+  vetrina.posizione = { lat: NEGOZIO.lat, lng: NEGOZIO.lng };
+});
+
+/** Una casa a 2 km a est del negozio, dentro il confine. */
+const CASA_VICINA: Coord = { lat: NEGOZIO.lat, lng: NEGOZIO.lng + 2 / (111.32 * Math.cos((NEGOZIO.lat * Math.PI) / 180)) };
+const segni = () => avvisi.filter((a) => /distanza non misurata/i.test(a.titolo));
+
+describe('R28-024 · l’ordine che la cassa non ha potuto misurare porta un segno', () => {
+  it('negozio senza posizione sulla vetrina: l’ordine nasce e gli amministratori lo sanno, col perché', async () => {
+    vetrina.posizione = null;
+    const { res } = await paga(CASA_VICINA, 'geocodifica');
+    expect(res.status).toBe(200);
+    expect(ordiniCreati).toHaveLength(1);
+    expect(segni()).toHaveLength(1);
+    expect(segni()[0].corpo).toContain('il negozio non ha la posizione sulla mappa');
+    expect(segni()[0].corpo).toContain('ord-1');
+    expect(segni()[0].link).toBe('/admin/orders/ord-1');
+  });
+
+  it('indirizzo che non si trova sulla mappa: l’ordine nasce e gli amministratori lo sanno, col perché', async () => {
+    const { res } = await paga(null, 'geocodifica');
+    expect(res.status).toBe(200);
+    expect(ordiniCreati).toHaveLength(1);
+    expect(segni()).toHaveLength(1);
+    expect(segni()[0].corpo).toContain('non si trova sulla mappa');
+  });
+
+  it('negozio e casa sulla mappa, dentro il confine: nessun segno', async () => {
+    const { res } = await paga(CASA_VICINA, 'rubrica');
+    expect(res.status).toBe(200);
+    expect(ordiniCreati).toHaveLength(1);
+    expect(segni()).toHaveLength(0);
+  });
+});

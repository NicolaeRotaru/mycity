{
  "extends": ["next/core-web-vitals", "plugin:jsx-a11y/recommended"],
  "rules": {
    "@next/next/no-img-element": "off",
    "@next/next/no-before-interactive-script-outside-document": "off",
    "react/no-unescaped-entities": "off",
    "react-hooks/exhaustive-deps": "warn",

    "no-restricted-syntax": [
      "error",
      {
        "selector": "MemberExpression[object.object.name='process'][object.property.name='env'][property.name='NEXT_PUBLIC_SITE_URL']",
        "message": "NEXT_PUBLIC_SITE_URL non esiste in questo progetto: il punto unico per l'indirizzo del sito e env.appUrl() in lib/env.ts. Una seconda variabile per la stessa cosa e il difetto che faceva rispondere 500 alla disiscrizione."
      }
    ],

    "jsx-a11y/label-has-associated-control": "warn",
    "jsx-a11y/click-events-have-key-events": "warn",
    "jsx-a11y/no-static-element-interactions": "warn",
    "jsx-a11y/no-noninteractive-element-interactions": "warn",
    "jsx-a11y/no-autofocus": "warn"
  }
}
